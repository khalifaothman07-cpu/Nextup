# NextUp has no build step today, so the browser-side Supabase URL and
# publishable key are hardcoded directly in js/supabase-client.js rather than
# injected from env vars. This file documents the server-side secrets that
# matter (set via `supabase secrets set`, never committed) and the values a
# future build step would need if one is introduced — see
# docs/ASSUMPTIONS.md #2 and docs/DEPLOYMENT.md.

# --- Supabase Edge Function secrets (set via `supabase secrets set`) ---

# Coinbase Commerce API key, from a real business account at
# commerce.coinbase.com. Required for create-charge/deposit to create real
# checkout sessions; without it they return a clear 503, not a fake success.
COMMERCE_API_KEY=

# Shared secret from the Coinbase Commerce webhook you configure to point at
# https://<project-ref>.supabase.co/functions/v1/coinbase-webhook. Used to
# verify X-CC-Webhook-Signature — never trust an unsigned webhook body.
COMMERCE_WEBHOOK_SECRET=

# Where Coinbase Commerce should redirect after checkout. Defaults to
# https://nextup.exchange if unset.
SITE_URL=

# --- Automatically provided inside Supabase Edge Functions (do not set) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected by
# the Supabase Edge Functions runtime itself. Never hardcode the service role
# key anywhere in client-reachable code.
